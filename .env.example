# Public address of the site (used for SEO links and the sitemap)
NEXT_PUBLIC_SITE_URL=https://example.com

# Contact form — https://resend.com
RESEND_API_KEY=
# Where the messages arrive (defaults to the email in src/config/site.ts)
CONTACT_TO_EMAIL=
# Sender verified in Resend, e.g. Stars Media <site@yourdomain.com>
CONTACT_FROM_EMAIL=
